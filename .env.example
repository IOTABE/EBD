# Configurações da EBD (copie para .env e ajuste)
# SECRET_KEY: gere uma forte para produção (ex.: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
# Produção: False e informe os hosts separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.0.62,ibnj.top,www.ibnj.top
# Apenas produção (DEBUG=False): URL do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
# Exemplo:
# DATABASE_URL=postgresql://ebd_user:Sab3dor1a@localhost:5432/EBD_DADO
DATABASE_URL=   